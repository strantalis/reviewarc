---
import "../styles/landing.css";
import reviewArcMark from "../assets/reviewarc-mark.svg";
import ThemeControl from "../components/ThemeControl.astro";
import ThemeBootstrap from "../components/ThemeBootstrap.astro";

const title = "ReviewArc — Agent review. Human judgment.";
const description =
  "ReviewArc reviews pull requests with a local AI agent, validates its evidence, and brings only consequential risks and unresolved uncertainty to you for judgment.";
const canonical = new URL("/", Astro.site);
const ogImage = new URL("/images/og/reviewarc-og.png", Astro.site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ReviewArc",
  applicationCategory: "DeveloperApplication",
  description,
  url: canonical.href,
  image: ogImage.href,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f8fb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171d26" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ReviewArc" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ReviewArc — Agent review. Human judgment." />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <ThemeBootstrap />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/commissioner-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/spline-sans-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="ReviewArc home">
        <img class="brand-mark" src={reviewArcMark.src} alt="" width="31" height="25" />
        <span>ReviewArc</span>
      </a>
      <nav aria-label="Primary navigation">
        <a class="wide-nav-link" href="#review-arc">How it works</a>
        <a href="/docs/">Docs</a>
        <a class="header-download is-loading" data-release-action aria-disabled="true">Checking…</a>
        <ThemeControl />
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-panel">
          <div class="hero-copy">
            <div class="hero-message">
              <p class="availability-line" data-state="loading"><span class="status-dot" aria-hidden="true"></span>Agent-led pull request review</p>
              <h1 id="hero-title">Let the agent review the pull request. <span>You make the call.</span></h1>
              <p class="lede">ReviewArc inspects the change and relevant surrounding code, validates its evidence, and brings only consequential risks and unresolved uncertainty to you for judgment.</p>

              <div class="download-group">
                <a class="download-button is-loading" id="download" data-release-action aria-disabled="true">
                  <span data-release-title>Checking signed release</span>
                  <small data-release-detail>Latest signed desktop build</small>
                </a>
              </div>

              <noscript>
                <p class="noscript-download">
                  JavaScript is off, so the live download check can't run.
                  <a href="/releases/">Browse releases and signed downloads</a>.
                </p>
              </noscript>

              <div class="release-status" id="release-status" data-state="loading" aria-busy="true">
                <p id="release-meta" role="status">Loading the latest signed release details…</p>
                <div class="release-status-actions">
                  <button id="retry-release" type="button" hidden>Try again</button>
                  <a id="release-details" href="/docs/getting-started/" hidden>Release notes and checksum</a>
                </div>
              </div>
            </div>

            <aside class="evidence-specimen" aria-label="Example ReviewArc recommendation with supporting evidence">
              <div class="specimen-heading">
                <span>Agent recommendation</span>
                <strong><span aria-hidden="true">✓</span> Evidence validated</strong>
              </div>
              <p class="specimen-claim">Hold: an external callback runs inside the global limiter lock.</p>
              <dl>
                <div><dt>Judgment</dt><dd>Resolve or explicitly accept</dd></div>
                <div><dt>Evidence</dt><dd><code>quota/limiter.go · L39–62</code></dd></div>
                <div><dt>Coverage</dt><dd>4 of 4 changed files inspected</dd></div>
              </dl>
              <p class="specimen-note">Challenge the recommendation by opening its cited code. ReviewArc keeps verified evidence and remaining blind spots visible before you approve.</p>
            </aside>
          </div>
        </div>

        <figure class="product-visual hero-visual">
          <div class="visual-stage">
            <img
              src="/images/reviewarc-agent-review.webp"
              data-theme-image
              data-light-src="/images/reviewarc-agent-review.webp"
              data-dark-src="/images/reviewarc-agent-review-dark.webp"
              width="1586"
              height="992"
              alt="ReviewArc's agent review brief showing a hold recommendation, changes, judgments requiring attention, verified evidence, and blind spots"
              fetchpriority="high"
            />
          </div>
          <figcaption><strong>Start with the agent's recommendation, then inspect only what could change your decision.</strong></figcaption>
        </figure>
      </section>

      <section class="review-arc" id="review-arc" aria-labelledby="review-arc-title">
        <header class="section-intro">
          <p class="section-label">How a review works</p>
          <h2 id="review-arc-title">The agent does the broad review. You decide what remains.</h2>
          <p>ReviewArc organizes each pull request around the confidence you need to approve—not the order of files in the diff.</p>
        </header>
        <div class="arc-flow">
          <article><strong>Clear the gate</strong><p>Wait for CI before spending agent or reviewer attention on a change that is not ready.</p></article>
          <article><strong>Read the recommendation</strong><p>See what changed, the agent's approval posture, and the evidence and coverage behind it.</p></article>
          <article><strong>Judge the exceptions</strong><p>Focus on consequential risks and uncertainty that the repository evidence could not settle.</p></article>
          <article><strong>Confirm the decision</strong><p>Inspect cited code, draft comments, and explicitly choose what reaches GitHub.</p></article>
        </div>
      </section>

      <section class="product-story" aria-labelledby="product-story-title">
        <figure class="product-visual review-visual">
          <div class="visual-stage">
            <img
              src="/images/reviewarc-judgment.webp"
              data-theme-image
              data-light-src="/images/reviewarc-judgment.webp"
              data-dark-src="/images/reviewarc-judgment-dark.webp"
              width="1586"
              height="992"
              alt="ReviewArc's focused judgment view showing why a risk matters, validated evidence, existing discussion, and the reviewer's decision"
              loading="lazy"
            />
          </div>
          <figcaption><strong>One consequential judgment, with the code and decision kept in reach.</strong></figcaption>
        </figure>
        <div class="story-copy">
          <h2 id="product-story-title">Go deeper only when the decision needs it.</h2>
          <p>Each judgment explains the tradeoff, cites the exact revision, and keeps surrounding code, existing discussion, and a draft response one step away.</p>
          <ul class="proof-list">
            <li><strong>Evidence</strong><span>Open the cited lines or surrounding code without losing the judgment.</span></li>
            <li><strong>Context</strong><span>See existing discussion attached to the affected code.</span></li>
            <li><strong>Decision</strong><span>Accept the tradeoff or turn it into an editable local draft.</span></li>
          </ul>
        </div>
      </section>

      <section class="trust-section" aria-labelledby="trust-title">
        <div class="trust-statement">
          <p class="section-label">Local until you publish</p>
          <h2 id="trust-title">Nothing reaches GitHub until you confirm it.</h2>
        </div>
        <div class="trust-summary">
          <p>ReviewArc works in its own copy of the repository. Your checkout stays untouched, and your notes and drafts stay local.</p>
          <a class="secondary-action" href="/docs/security-and-local-data/">Read about security and local data <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="final-cta" aria-labelledby="final-cta-title">
        <div>
          <p class="section-label">For your next consequential pull request</p>
          <h2 id="final-cta-title">Try ReviewArc on a change where confidence matters.</h2>
        </div>
        <div class="final-actions">
          <a class="download-button is-loading" data-release-action aria-disabled="true"><span data-release-title>Checking signed release</span><small data-release-detail>Latest signed desktop build</small></a>
          <a class="secondary-action" data-release-secondary href="/docs/getting-started/">Read the setup guide <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>

    <footer>
      <a class="brand footer-brand" href="/" aria-label="ReviewArc home">
        <img class="brand-mark" src={reviewArcMark.src} alt="" width="31" height="25" />
        <span>ReviewArc</span>
      </a>
      <span>A focused pull request reviewer.</span>
      <nav aria-label="Footer navigation"><a href="/docs/">Docs</a><a href="/docs/security-and-local-data/">Security</a><a href="/legal/notices/">Legal</a><a class="is-loading" data-release-action aria-disabled="true">Checking…</a></nav>
    </footer>

    <script>
      import "../scripts/release";
    </script>
  </body>
</html>
