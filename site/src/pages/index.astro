---
import "../styles/landing.css";
import reviewArcMark from "../assets/reviewarc-mark.svg";
import ThemeControl from "../components/ThemeControl.astro";
import ThemeBootstrap from "../components/ThemeBootstrap.astro";

const title = "ReviewArc — Let the agent review. You make the call.";
const description =
  "ReviewArc reads the pull request and surrounding code, checks the evidence, and shows you only the decisions that still need a human.";
const canonical = new URL("/", Astro.site);
const ogImage = new URL("/images/og/reviewarc-og.png", Astro.site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ReviewArc",
  applicationCategory: "DeveloperApplication",
  description,
  url: canonical.href,
  image: ogImage.href,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f8fb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171d26" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ReviewArc" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ReviewArc — Let the agent review. You make the call." />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <ThemeBootstrap />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/commissioner-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/spline-sans-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="ReviewArc home">
        <img class="brand-mark" src={reviewArcMark.src} alt="" width="31" height="25" />
        <span>ReviewArc</span>
      </a>
      <nav aria-label="Primary navigation">
        <a class="wide-nav-link" href="#review-arc">How it works</a>
        <a href="/docs/">Docs</a>
        <a class="header-download is-loading" data-release-action aria-disabled="true">Checking…</a>
        <ThemeControl />
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-panel">
          <div class="hero-copy">
            <div class="hero-message">
              <p class="availability-line" data-state="loading"><span class="status-dot" aria-hidden="true"></span>AI code review that keeps you in control</p>
              <h1 id="hero-title">Let the agent do the review. <span>You make the call.</span></h1>
              <p class="lede">ReviewArc reads the pull request, follows the change into surrounding code, and gives you a recommendation. If something still needs your attention, it shows you why and where to look.</p>

              <div class="download-group">
                <a class="download-button is-loading" id="download" data-release-action aria-disabled="true">
                  <span data-release-title>Checking signed release</span>
                  <small data-release-detail>Latest signed desktop build</small>
                </a>
              </div>

              <noscript>
                <p class="noscript-download">
                  JavaScript is off, so the live download check can't run.
                  <a href="/releases/">Browse releases and signed downloads</a>.
                </p>
              </noscript>

              <div class="release-status" id="release-status" data-state="loading" aria-busy="true">
                <p id="release-meta" role="status">Loading the latest signed release details…</p>
                <div class="release-status-actions">
                  <button id="retry-release" type="button" hidden>Try again</button>
                  <a id="release-details" href="/docs/getting-started/" hidden>Release notes and checksum</a>
                </div>
              </div>
            </div>

            <aside class="evidence-specimen" aria-label="Example ReviewArc recommendation with checked evidence">
              <div class="specimen-heading">
                <span>Review complete</span>
                <strong><span aria-hidden="true">✓</span> Evidence checked</strong>
              </div>
              <p class="specimen-claim">Hold: this callback may deadlock under load.</p>
              <dl>
                <div><dt>Next step</dt><dd>Fix before approval</dd></div>
                <div><dt>Why</dt><dd>The callback runs while the global lock is held</dd></div>
                <div><dt>Look here</dt><dd><code>quota/limiter.go · L39–62</code></dd></div>
              </dl>
              <p class="specimen-note">You do not have to retrace the whole review. Open the cited code when you want to challenge the agent's conclusion.</p>
            </aside>
          </div>
        </div>

        <figure class="product-visual hero-visual">
          <div class="visual-stage">
            <img
              src="/images/reviewarc-review-brief-demo.webp"
              data-theme-image
              data-light-src="/images/reviewarc-review-brief-demo.webp"
              data-dark-src="/images/reviewarc-review-brief-demo.webp"
              width="1587"
              height="991"
              alt="ReviewArc's real review brief with fictional demo content, showing an insufficient-evidence recommendation and three judgments needing attention"
              fetchpriority="high"
            />
          </div>
          <figcaption><strong>Start with the recommendation. Open the code only when you need to challenge it.</strong></figcaption>
        </figure>
      </section>

      <section class="review-arc" id="review-arc" aria-labelledby="review-arc-title">
        <header class="section-intro">
          <p class="section-label">How a review works</p>
          <h2 id="review-arc-title">A code review, not another summary to review.</h2>
          <p>ReviewArc does the first pass across the pull request and surrounding code. You step in only for decisions it cannot safely make for you.</p>
        </header>
        <div class="arc-flow">
          <article><strong>Wait for green CI</strong><p>ReviewArc pauses while checks are failing or still running.</p></article>
          <article><strong>Get the recommendation</strong><p>See whether the agent would approve, hold, or ask for more evidence—and why.</p></article>
          <article><strong>Handle what is unresolved</strong><p>Review only the few risks or tradeoffs that still need your experience.</p></article>
          <article><strong>Send your review</strong><p>Edit the comments and confirm exactly what GitHub receives.</p></article>
        </div>
      </section>

      <section class="product-story" aria-labelledby="product-story-title">
        <figure class="product-visual review-visual">
          <div class="visual-stage">
            <img
              src="/images/reviewarc-judgment-demo.webp"
              data-theme-image
              data-light-src="/images/reviewarc-judgment-demo.webp"
              data-dark-src="/images/reviewarc-judgment-demo.webp"
              width="1587"
              height="991"
              alt="ReviewArc's real focused judgment view with fictional demo content, showing why a risk matters, validated evidence, and navigation between judgments"
              loading="lazy"
            />
          </div>
          <figcaption><strong>One clear question, the code behind it, and a way forward.</strong></figcaption>
        </figure>
        <div class="story-copy">
          <h2 id="product-story-title">When it needs you, it gets specific.</h2>
          <p>Each question explains what could go wrong, points to the exact code behind it, and offers a clear next step. You can challenge the agent without reopening the whole diff.</p>
          <ul class="proof-list">
            <li><strong>Question</strong><span>See what could go wrong and why it matters.</span></li>
            <li><strong>Code</strong><span>Open the cited lines and surrounding context.</span></li>
            <li><strong>Response</strong><span>Accept the risk, request a change, or ask for more context.</span></li>
          </ul>
        </div>
      </section>

      <section class="trust-section" aria-labelledby="trust-title">
        <div class="trust-statement">
          <p class="section-label">Local until you publish</p>
          <h2 id="trust-title">The agent can investigate. It cannot publish for you.</h2>
        </div>
        <div class="trust-summary">
          <p>ReviewArc works in its own copy of the repository. Your checkout stays untouched, and every note, draft, and decision stays on your Mac until you confirm the review.</p>
          <a class="secondary-action" href="/docs/security-and-local-data/">Read about security and local data <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="final-cta" aria-labelledby="final-cta-title">
        <div>
          <p class="section-label">For the next pull request you cannot skim</p>
          <h2 id="final-cta-title">Get a real first pass without another wall of text.</h2>
        </div>
        <div class="final-actions">
          <a class="download-button is-loading" data-release-action aria-disabled="true"><span data-release-title>Checking signed release</span><small data-release-detail>Latest signed desktop build</small></a>
          <a class="secondary-action" data-release-secondary href="/docs/getting-started/">Read the setup guide <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>

    <footer>
      <a class="brand footer-brand" href="/" aria-label="ReviewArc home">
        <img class="brand-mark" src={reviewArcMark.src} alt="" width="31" height="25" />
        <span>ReviewArc</span>
      </a>
      <span>AI code review that leaves the call with you.</span>
      <nav aria-label="Footer navigation"><a href="/docs/">Docs</a><a href="/docs/security-and-local-data/">Security</a><a href="/legal/notices/">Legal</a><a class="is-loading" data-release-action aria-disabled="true">Checking…</a></nav>
    </footer>

    <script>
      import "../scripts/release";
    </script>
  </body>
</html>
