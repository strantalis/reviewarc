---
import "../styles/landing.css";
import reviewArcMark from "../assets/reviewarc-mark.svg";
import ThemeControl from "../components/ThemeControl.astro";
import ThemeBootstrap from "../components/ThemeBootstrap.astro";

const title = "ReviewArc — The first pass is the agent's. The approval is yours.";
const description =
  "ReviewArc is a macOS app that runs Codex or Claude Code over a pull request, verifies every citation against the exact revision, and leaves the approval with you.";
const canonical = new URL("/", Astro.site);
const ogImage = new URL("/images/og/reviewarc-og.jpg", Astro.site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ReviewArc",
  applicationCategory: "DeveloperApplication",
  description,
  url: canonical.href,
  image: ogImage.href,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f8fb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171d26" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ReviewArc" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ReviewArc — The first pass is the agent's. The approval is yours." />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <ThemeBootstrap />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/commissioner-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/spline-sans-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="ReviewArc home">
        <img class="brand-mark" src={reviewArcMark.src} alt="" width="31" height="25" />
        <span>ReviewArc</span>
      </a>
      <nav aria-label="Primary navigation">
        <a class="wide-nav-link" href="#review-arc">How it works</a>
        <a href="/docs/">Docs</a>
        <a class="header-download is-loading" data-release-action aria-disabled="true">Checking…</a>
        <ThemeControl />
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-panel">
          <div class="hero-copy">
            <div class="hero-message">
              <p class="availability-line">Native macOS app for GitHub pull requests</p>
              <h1 id="hero-title">The first pass is the agent's. <span>The approval is yours.</span></h1>
              <p class="lede">ReviewArc runs Codex or Claude Code over the pull request and the code around it. You get a recommendation and a short list of findings that need a human decision, each citing file and lines verified against the exact revision under review.</p>

              <div class="download-group">
                <a class="download-button is-loading" id="download" data-release-action aria-disabled="true">
                  <span data-release-title>Checking signed release</span>
                  <small data-release-detail>Signed macOS build</small>
                </a>
              </div>

              <noscript>
                <p class="noscript-download">
                  JavaScript is off, so the live download check can't run.
                  <a href="/releases/">Browse releases and signed downloads</a>.
                </p>
              </noscript>

              <div class="release-status" id="release-status" data-state="loading" aria-busy="true">
                <p id="release-meta" role="status">Loading the latest signed release details…</p>
                <div class="release-status-actions">
                  <button id="retry-release" type="button" hidden>Try again</button>
                  <a id="release-details" href="/docs/getting-started/" hidden>Release notes and checksum</a>
                </div>
              </div>
            </div>

            <aside class="evidence-specimen" aria-label="Example ReviewArc recommendation with checked evidence">
              <div class="specimen-heading">
                <span>Review complete</span>
                <strong><span aria-hidden="true">✓</span> Evidence checked</strong>
              </div>
              <p class="specimen-claim">Hold: this callback may deadlock under load.</p>
              <dl>
                <div><dt>Next step</dt><dd>Fix before approval</dd></div>
                <div><dt>Why</dt><dd>The callback runs while the global lock is held</dd></div>
                <div><dt>Look here</dt><dd><code>quota/limiter.go · L39–62</code></dd></div>
              </dl>
              <p class="specimen-note">Open the cited lines to check the reasoning yourself. The path and range are validated against the reviewed revision.</p>
            </aside>
          </div>
        </div>

        <figure class="product-visual hero-visual">
          <div class="visual-stage">
            <img
              src="/images/reviewarc-review-brief-demo.webp"
              width="1587"
              height="991"
              alt="ReviewArc's real review brief with fictional demo content, showing an insufficient-evidence recommendation and three judgments needing attention"
              fetchpriority="high"
            />
          </div>
          <figcaption><strong>The review brief: the recommendation, what the agent covered, and the findings waiting on your decision.</strong></figcaption>
        </figure>
      </section>

      <section class="review-arc" id="review-arc" aria-labelledby="review-arc-title">
        <header class="section-intro">
          <p class="section-label">How a review works</p>
          <h2 id="review-arc-title">From inbox to published review.</h2>
          <p>The agent does the broad pass, and the brief reports exactly what it covered—including what it didn't read. You step through only the findings that could change the approval decision, high-risk first.</p>
        </header>
        <div class="arc-flow">
          <article><strong>Green CI first</strong><p>Analysis waits while required checks are failing or still running.</p></article>
          <article><strong>Read the brief</strong><p>Ready for approval, hold, or insufficient evidence—plus what was verified and where the blind spots are.</p></article>
          <article><strong>Decide the open findings</strong><p>High-risk first. Accept a tradeoff with a rationale, or turn it into a draft comment for the author.</p></article>
          <article><strong>Confirm, then publish</strong><p>Preview the exact payload—comment, approve, or request changes. Nothing posts until you confirm.</p></article>
        </div>
      </section>

      <section class="product-story" aria-labelledby="product-story-title">
        <figure class="product-visual review-visual">
          <div class="visual-stage">
            <img
              src="/images/reviewarc-judgment-demo.webp"
              width="1587"
              height="991"
              alt="ReviewArc's real focused judgment view with fictional demo content, showing why a risk matters, validated evidence, and navigation between judgments"
              loading="lazy"
            />
          </div>
          <figcaption><strong>Why the risk matters, the validated citation, and your decision—one finding at a time.</strong></figcaption>
        </figure>
        <div class="story-copy">
          <h2 id="product-story-title">Every claim points to real code.</h2>
          <p>Open a finding and you get why it matters, the cited lines, and what to do about it. ReviewArc validates every citation against the pinned revision before showing it—and anything it can't validate stays labeled unverified.</p>
          <ul class="proof-list">
            <li><strong>Risk</strong><span>Why this finding could change your approval decision.</span></li>
            <li><strong>Code</strong><span>The cited lines, the diff, and the discussion already on them.</span></li>
            <li><strong>Decision</strong><span>Accept the tradeoff with a rationale, or draft a comment for the author.</span></li>
          </ul>
        </div>
      </section>

      <section class="trust-section" aria-labelledby="trust-title">
        <div class="trust-statement">
          <p class="section-label">Local until you publish</p>
          <h2 id="trust-title">The agent can investigate. It cannot publish for you.</h2>
        </div>
        <div class="trust-summary">
          <p>ReviewArc works in its own managed copy of the repository, and the agent runs read-only—no project scripts, no commands, no writes. Notes, drafts, and decisions stay on your Mac until you confirm the review.</p>
          <a class="secondary-action" href="/docs/security-and-local-data/">Read about security and local data <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="final-cta" aria-labelledby="final-cta-title">
        <div>
          <p class="section-label">Free · signed and notarized · your own Codex or Claude Code</p>
          <h2 id="final-cta-title">Try it on your next PR.</h2>
        </div>
        <div class="final-actions">
          <a class="download-button is-loading" data-release-action aria-disabled="true"><span data-release-title>Checking signed release</span><small data-release-detail>Signed macOS build</small></a>
          <a class="secondary-action" data-release-secondary href="/docs/getting-started/">Read the setup guide <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>

    <footer>
      <a class="brand footer-brand" href="/" aria-label="ReviewArc home">
        <img class="brand-mark" src={reviewArcMark.src} alt="" width="31" height="25" />
        <span>ReviewArc</span>
      </a>
      <span>A pull request review client for macOS.</span>
      <nav aria-label="Footer navigation"><a href="/docs/">Docs</a><a href="/docs/security-and-local-data/">Security</a><a href="/legal/notices/">Legal</a><a class="is-loading" data-release-action aria-disabled="true">Checking…</a></nav>
    </footer>

    <script>
      import "../scripts/release";
    </script>
  </body>
</html>
