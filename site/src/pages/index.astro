---
import "../styles/landing.css";
import reviewArcMark from "../assets/reviewarc-mark.svg";
import ThemeControl from "../components/ThemeControl.astro";
import ThemeBootstrap from "../components/ThemeBootstrap.astro";

const title = "ReviewArc — Review the change. Follow the evidence.";
const description =
  "ReviewArc is a guided pull request review app that breaks large GitHub pull requests into focused chapters, with the relevant diff, risks, tests, and evidence kept together.";
const canonical = new URL("/", Astro.site);
const ogImage = new URL("/images/og/reviewarc-og.png", Astro.site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ReviewArc",
  applicationCategory: "DeveloperApplication",
  description,
  url: canonical.href,
  image: ogImage.href,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f8fb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171d26" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ReviewArc" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ReviewArc — Review the change. Follow the evidence." />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <ThemeBootstrap />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/commissioner-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/spline-sans-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="ReviewArc home">
        <img class="brand-mark" src={reviewArcMark.src} alt="" width="31" height="25" />
        <span>ReviewArc</span>
      </a>
      <nav aria-label="Primary navigation">
        <a class="wide-nav-link" href="#review-arc">How it works</a>
        <a href="/docs/">Docs</a>
        <a class="header-download is-loading" data-release-action aria-disabled="true">Checking…</a>
        <ThemeControl />
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-panel">
          <div class="hero-copy">
            <div class="hero-message">
              <p class="availability-line" data-state="loading"><span class="status-dot" aria-hidden="true"></span>Guided pull request review</p>
              <h1 id="hero-title">Review the change. <span>Follow the evidence.</span></h1>
              <p class="lede">ReviewArc breaks a pull request into focused chapters, with the relevant diff, risks, tests, and open questions kept together.</p>

              <div class="download-group">
                <a class="download-button is-loading" id="download" data-release-action aria-disabled="true">
                  <span data-release-title>Checking signed release</span>
                  <small data-release-detail>Latest signed desktop build</small>
                </a>
              </div>

              <noscript>
                <p class="noscript-download">
                  JavaScript is off, so the live download check can't run.
                  <a href="/releases/">Browse releases and signed downloads</a>.
                </p>
              </noscript>

              <div class="release-status" id="release-status" data-state="loading" aria-busy="true">
                <p id="release-meta" role="status">Loading the latest signed release details…</p>
                <div class="release-status-actions">
                  <button id="retry-release" type="button" hidden>Try again</button>
                  <a id="release-details" href="/docs/getting-started/" hidden>Release notes and checksum</a>
                </div>
              </div>
            </div>

            <aside class="evidence-specimen" aria-label="Example ReviewArc finding with supporting code">
              <div class="specimen-heading">
                <span>Example claim</span>
                <strong><span aria-hidden="true">✓</span> Backed by code</strong>
              </div>
              <p class="specimen-claim">The audit recorder is optional; existing callers do not need to configure one.</p>
              <dl>
                <div><dt>File</dt><dd><code>quota/limiter.go</code></dd></div>
                <div><dt>Lines</dt><dd><code>L34–37 · L39–62</code></dd></div>
                <div><dt>Revision</dt><dd><code>feature/burst-audit</code></dd></div>
              </dl>
              <p class="specimen-note">Open the cited file and lines from the finding. Anything the code does not directly support is labeled as an inference or open question.</p>
            </aside>
          </div>
        </div>

        <figure class="product-visual hero-visual">
          <div class="visual-stage">
            <img
              src="/images/reviewarc-guided-review.webp"
              data-theme-image
              data-light-src="/images/reviewarc-guided-review.webp"
              data-dark-src="/images/reviewarc-guided-review-dark.webp"
              width="1586"
              height="992"
              alt="ReviewArc's guided review showing one chapter with a validated risk, collapsed code evidence, an open question, and a behavioral change"
              fetchpriority="high"
            />
          </div>
          <figcaption><strong>The guided review keeps the chapter, code, and evidence in one view.</strong></figcaption>
        </figure>
      </section>

      <section class="review-arc" id="review-arc" aria-labelledby="review-arc-title">
        <header class="section-intro">
          <p class="section-label">How a review works</p>
          <h2 id="review-arc-title">Start with the change, then move into the code.</h2>
          <p>ReviewArc organizes each pull request around the questions a reviewer needs to answer—not the order of files in the diff.</p>
        </header>
        <div class="arc-flow">
          <article><strong>Get oriented</strong><p>See what changed, why it matters, and where the risk is concentrated.</p></article>
          <article><strong>Work through it</strong><p>Review focused chapters beside the relevant diff and supporting code.</p></article>
          <article><strong>Check the claims</strong><p>Separate code-backed facts from inferences, risks, tests, and open questions.</p></article>
          <article><strong>Make the call</strong><p>Keep your progress, notes, drafts, and unresolved questions together until you are ready.</p></article>
        </div>
      </section>

      <section class="product-story" aria-labelledby="product-story-title">
        <figure class="product-visual review-visual">
          <div class="visual-stage">
            <img
              src="/images/reviewarc-inbox.webp"
              data-theme-image
              data-light-src="/images/reviewarc-inbox.webp"
              data-dark-src="/images/reviewarc-inbox-dark.webp"
              width="1586"
              height="992"
              alt="ReviewArc's pull request inbox showing saved views, repository filters, review relationships, and analysis state"
              loading="lazy"
            />
          </div>
          <figcaption><strong>Your review queue, across the repositories you choose.</strong></figcaption>
        </figure>
        <div class="story-copy">
          <h2 id="product-story-title">One inbox for the repositories you review.</h2>
          <p>The inbox keeps selected repositories, analysis state, and reviewer context visible. Open a pull request and return to the guided review where you left off.</p>
          <ul class="proof-list">
            <li><strong>Repositories</strong><span>See only the repositories you chose to review.</span></li>
            <li><strong>Analysis</strong><span>Know which pull requests are ready to open.</span></li>
            <li><strong>Progress</strong><span>Return to the chapter you were working through.</span></li>
          </ul>
        </div>
      </section>

      <section class="trust-section" aria-labelledby="trust-title">
        <div class="trust-statement">
          <p class="section-label">Local until you publish</p>
          <h2 id="trust-title">Nothing reaches GitHub until you confirm it.</h2>
        </div>
        <div class="trust-summary">
          <p>ReviewArc works in its own copy of the repository. Your checkout stays untouched, and your notes and drafts stay local.</p>
          <a class="secondary-action" href="/docs/security-and-local-data/">Read about security and local data <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="final-cta" aria-labelledby="final-cta-title">
        <div>
          <p class="section-label">For your next large pull request</p>
          <h2 id="final-cta-title">Try ReviewArc on a change that needs a closer look.</h2>
        </div>
        <div class="final-actions">
          <a class="download-button is-loading" data-release-action aria-disabled="true"><span data-release-title>Checking signed release</span><small data-release-detail>Latest signed desktop build</small></a>
          <a class="secondary-action" data-release-secondary href="/docs/getting-started/">Read the setup guide <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>

    <footer>
      <a class="brand footer-brand" href="/" aria-label="ReviewArc home">
        <img class="brand-mark" src={reviewArcMark.src} alt="" width="31" height="25" />
        <span>ReviewArc</span>
      </a>
      <span>A focused pull request reviewer.</span>
      <nav aria-label="Footer navigation"><a href="/docs/">Docs</a><a href="/docs/security-and-local-data/">Security</a><a class="is-loading" data-release-action aria-disabled="true">Checking…</a></nav>
    </footer>

    <script>
      import "../scripts/release";
    </script>
  </body>
</html>
