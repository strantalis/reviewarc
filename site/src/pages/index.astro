---
import "../styles/landing.css";
import reviewArcMark from "../assets/reviewarc-mark.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f3f5f8" />
    <meta name="description" content="ReviewArc turns pull request review into a guided, evidence-backed journey." />
    <title>ReviewArc — Review the change, not the noise</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&amp;family=Newsreader:opsz,wght@6..72,500;6..72,600&amp;display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="ReviewArc home">
        <img class="brand-mark" src={reviewArcMark.src} alt="" width="31" height="25" />
        <span>ReviewArc</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/docs/">Docs</a>
        <span class="platform-label">For macOS</span>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero">
        <div class="hero-copy">
          <div class="hero-message">
            <p class="eyebrow" id="channel-label"><span class="status-dot"></span><span id="channel-copy">ReviewArc for macOS</span></p>
            <h1>Review the change.<br /><em>Understand the risk.</em></h1>
          </div>
          <div class="hero-support">
            <p class="lede">A local-first review workspace that turns sprawling pull requests into a guided path through behavior, evidence, tests, and uncertainty.</p>
            <div class="download-group">
              <a class="download-button is-loading" id="download" aria-disabled="true">
                <span>Preparing release</span>
                <small>Universal macOS build</small>
              </a>
              <p class="release-meta" id="release-meta" role="status">Checking the latest release…</p>
            </div>
            <a class="quiet-link" href="/docs/getting-started/">Read the setup guide <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <figure class="product-visual hero-visual">
          <img src="/images/reviewarc-inbox.webp" width="1586" height="992" alt="ReviewArc's unified pull request inbox showing real review status, labels, and analysis state across repositories" fetchpriority="high" />
          <figcaption><span>Unified pull request inbox</span><span>One calm queue across the repositories you choose.</span></figcaption>
        </figure>
      </section>

      <section class="product-story" aria-labelledby="product-story-title">
        <div class="story-copy">
          <p class="section-kicker">A guided review workspace</p>
          <h2 id="product-story-title">Move through the change with evidence beside you.</h2>
          <p>ReviewArc organizes each pull request into focused chapters, keeps the real diff at the center, and connects risks, tests, unknowns, and discussion to the lines that support them.</p>
          <dl class="story-proof">
            <div><dt>Left</dt><dd>Chapters and progress</dd></div>
            <div><dt>Center</dt><dd>Code, diffs, and threads</dd></div>
            <div><dt>Right</dt><dd>Evidence and uncertainty</dd></div>
          </dl>
        </div>
        <figure class="product-visual review-visual">
          <img src="/images/reviewarc-guided-review.webp" width="1536" height="1024" alt="ReviewArc guided review with chapters, a code diff and inline thread, and evidence-backed risks in three panels" loading="lazy" />
        </figure>
      </section>

      <section class="principles" aria-labelledby="principles-title">
        <p class="section-kicker" id="principles-title">A review instrument, not an approval bot</p>
        <div class="principle-list">
          <article><span>01</span><h2>Evidence before assertion</h2><p>Every risk and inference traces back to the exact revision, file, and line that supports it.</p></article>
          <article><span>02</span><h2>Your repositories stay yours</h2><p>ReviewArc uses isolated managed caches. It never modifies your working checkouts or runs project commands.</p></article>
          <article><span>03</span><h2>You make the decision</h2><p>Analysis guides attention. Notes stay private. Nothing reaches GitHub without explicit confirmation.</p></article>
        </div>
      </section>
    </main>

    <footer>
      <span>ReviewArc</span>
      <span>Built for careful reviewers.</span>
      <a href="/docs/security-and-local-data/">Security and privacy</a>
    </footer>

    <script>
      import "../scripts/release";
    </script>
  </body>
</html>
