---
import "../../styles/landing.css";
import "../../styles/release.css";
import reviewArcMark from "../../assets/reviewarc-mark.svg";
import ThemeControl from "../../components/ThemeControl.astro";
import ThemeBootstrap from "../../components/ThemeBootstrap.astro";
import { loadReleaseVersion, NoReleaseError } from "../../lib/release-loader";
import { releaseNotesFor } from "../../lib/release-notes";
import type { ReleaseManifest } from "../../lib/release-manifest";

export const prerender = false;

const pathVersion = Astro.params.version ?? "";
const version = pathVersion.startsWith("v") ? pathVersion.slice(1) : "";
let manifest: ReleaseManifest | null = null;
let loadFailed = false;

try {
  manifest = version ? (await loadReleaseVersion(version)).manifest : null;
  if (!manifest) Astro.response.status = 404;
} catch (error) {
  Astro.response.status = error instanceof NoReleaseError ? 404 : 503;
  loadFailed = !(error instanceof NoReleaseError);
}

Astro.response.headers.set("Cache-Control", manifest ? "public, max-age=0, s-maxage=300" : "no-store");

const notes = manifest ? releaseNotesFor(manifest.version) : null;
const published = manifest
  ? new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" }).format(new Date(manifest.publishedAt))
  : "";
const size = manifest ? `${(manifest.macOS.sizeBytes / 1024 / 1024).toFixed(1)} MB` : "";
const pageTitle = manifest ? `ReviewArc ${manifest.version} release notes` : "ReviewArc release unavailable";
const pageDescription = manifest
  ? `Release notes and signed download details for ReviewArc ${manifest.version}.`
  : "ReviewArc release information.";
const canonical = manifest ? new URL(`/releases/v${manifest.version}/`, Astro.site) : null;
const ogImage = new URL("/images/og/reviewarc-og.jpg", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f8fb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171d26" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical.href} />}
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="ReviewArc" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {!manifest && <meta name="robots" content="noindex" />}
    <ThemeBootstrap />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/commissioner-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/spline-sans-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="ReviewArc home">
        <img class="brand-mark" src={reviewArcMark.src} alt="" width="31" height="25" />
        <span>ReviewArc</span>
      </a>
      <nav aria-label="Primary navigation">
        <a class="wide-nav-link" href="/#review-arc">How it works</a>
        <a href="/docs/">Docs</a>
        <a class="header-download" href="/#download">Download</a>
        <ThemeControl />
      </nav>
    </header>

    <main id="main-content" class="release-page">
      {manifest ? (
        <article>
          <header class="release-heading">
            <a class="back-link" href="/">← ReviewArc home</a>
            <p class="release-chip"><span class="status-dot" aria-hidden="true"></span>{manifest.channel === "beta" ? "Beta release" : "Stable release"}</p>
            <h1>ReviewArc <span>{manifest.version}</span></h1>
            <p class="release-summary">{notes?.summary ?? "Download this signed build and review what changed."}</p>
            <div class="release-actions">
              <a class="download-button" href={manifest.macOS.downloadUrl}>
                <span>Download for macOS</span>
                <small>Universal build · {size} · macOS {manifest.macOS.minimumVersion}+</small>
              </a>
              <span>Published {published}</span>
            </div>
          </header>

          <div class="release-body">
            <section aria-labelledby="changes-title">
              <p class="section-label">Release notes</p>
              <h2 id="changes-title">What changed.</h2>
              {notes ? (
                <ul class="change-list">
                  {notes.changes.map((change) => <li>{change}</li>)}
                </ul>
              ) : (
                <p class="muted-copy">No detailed notes were published for this build. The signed download and checksum are still available.</p>
              )}
            </section>

            <aside class="release-details" aria-labelledby="details-title">
              <p class="section-label" id="details-title">Release details</p>
              <dl>
                <div><dt>Version</dt><dd>{manifest.version}</dd></div>
                <div><dt>Build</dt><dd>{manifest.buildNumber}</dd></div>
                <div><dt>Channel</dt><dd>{manifest.channel === "beta" ? "Beta" : "Stable"}</dd></div>
                <div><dt>macOS</dt><dd>{manifest.macOS.minimumVersion} or newer</dd></div>
                <div><dt>Architectures</dt><dd>Apple Silicon and Intel</dd></div>
                <div><dt>Notarization</dt><dd>Accepted by Apple</dd></div>
              </dl>
              <div class="checksum">
                <span>SHA-256 checksum</span>
                <code>{manifest.macOS.sha256}</code>
              </div>
            </aside>
          </div>
        </article>
      ) : (
        <section class="release-unavailable">
          <p class="section-label">Release information</p>
          <h1>{loadFailed ? "Release details are temporarily unavailable." : "Release not found."}</h1>
          <p>{loadFailed ? "We couldn’t load the signed release details. Check your connection and try again, or continue to the setup guide." : "This version does not have a published ReviewArc release."}</p>
          <div class="unavailable-actions">
            {loadFailed && <a class="download-button compact-button" href={Astro.url.pathname}><span>Try again</span><small>Reload signed release details</small></a>}
            <a class="secondary-action" href="/docs/getting-started/">Open the setup guide <span aria-hidden="true">→</span></a>
            <a class="secondary-action" href="/">Return home</a>
          </div>
        </section>
      )}
    </main>

    <footer>
      <a class="brand footer-brand" href="/" aria-label="ReviewArc home">
        <img class="brand-mark" src={reviewArcMark.src} alt="" width="31" height="25" />
        <span>ReviewArc</span>
      </a>
      <span>A pull request review client for macOS.</span>
      <nav aria-label="Footer navigation"><a href="/docs/">Docs</a><a href="/docs/security-and-local-data/">Security</a><a href="/legal/notices/">Legal</a><a href="/#download">Download</a></nav>
    </footer>
  </body>
</html>
