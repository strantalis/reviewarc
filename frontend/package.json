{
  "name": "reviewarc-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "oxlint src scripts vite.config.ts",
    "lint:fix": "oxlint --fix src scripts vite.config.ts",
    "normalize:bindings": "node scripts/normalize-wails-bindings.mjs",
    "wails:dev": "npm run dev",
    "wails:build": "npm run normalize:bindings && npm run build",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@pierre/diffs": "1.2.12",
    "@radix-ui/react-select": "^2.3.7",
    "@vitejs/plugin-react": "6.0.4",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "0.25.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
